# Configure in Vercel Settings > Environment Variables. Never commit real values.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
# Canonical deployed origin, used to reject cross-origin admin writes.
SITE_ORIGIN=https://YOUR-SITE.vercel.app
# Enable only after applying SQL and importing the existing catalog.
CONTENT_BACKEND_ENABLED=false
